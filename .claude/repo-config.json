{
  "default_branch": "main",
  "hooks": {
    "protected_patterns": [
      "native/ConcordCrypto/",
      "src/ConcordCrypto\\.ts$",
      "src/ConcordAttest\\.ts$",
      "ios/.*\\.entitlements$",
      "ios/.*Info\\.plist$",
      "\\.github/workflows/",
      "\\.github/scripts/",
      "scripts/security/",
      "CODEOWNERS$",
      "(^|/)\\.claude/(hooks/|settings\\.json|repo-config\\.json|\\.agentic-dev-tooling\\.lock$)",
      "(^|/)scripts/repo-config\\.sh$"
    ]
  }
}
